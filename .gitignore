# ── Generated & local-only files ─────────────────────────────────────────────
# ChromaDB is rebuilt by running Steps 8–9b — too large to commit (~100MB+)
chroma_db/

# Lambda deployment zip — rebuilt by Step 3. 7MB binary, not useful in git
ade_lambda.zip

# Cropped PDF images generated at runtime by visual_grounding_helper.py
images/

# Cross-session memory — personal to each user's conversations
memory.json

# ── Course / Weights & Biases ─────────────────────────────────────────────────
# ignore wandb cache
**/wandb/*
**/artifacts/*

# ignore checkpoint files
**/.ipynb_checkpoints/*
**/*-checkpoint.ipynb
**/*-checkpoint.py

# ignore DS_Store files
**/.DS_Store

# ignore .env file
.env

# ignore .nbgrader.log
.nbgrader.log

# ignore pycache files
**/__pycache__/*

# ignore emacs leftover files
**/*~
**/#*#

# ignore untitled notebooks
**/Untitled.ipynb

# ignore key file
**/OPENAI_API_KEY.txt

# ignore virtual environment files
.venv/
venv/
.venv*/
.python-version
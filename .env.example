# Copy this file to .env and fill in your values
# Never commit your actual .env file — it's already in .gitignore

# ── Runtime boundary ────────────────────────────────────────────────────────
# public_demo is the safe default for HF: approved-public retrieval only,
# session-local chat, no uploads or persistent personal memory until auth ships.
# local_private enables the existing single-user workflow on 127.0.0.1 only.
# It cannot be used with --share or in a Hugging Face Space.
APP_MODE=public_demo

# ── Optional private demo sessions (see SUPABASE_SETUP.md) ───────────────────
# No sign-up is required for public chat. Enable only after the SQL migration,
# Supabase anonymous Auth, and Turnstile CAPTCHA have been configured.
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Generate a stable Fernet key locally; store it in HF Secrets, never in Git/chat.
SESSION_COOKIE_KEY=
APP_PUBLIC_URL=
TURNSTILE_SITE_KEY=

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ── AWS ───────────────────────────────────────────────────────────────────────
# IAM user with S3, Lambda, IAM, CloudWatch permissions
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-2
S3_BUCKET=your-s3-bucket-name

# ── LandingAI ─────────────────────────────────────────────────────────────────
# Free account at: https://va.landing.ai/
VISION_AGENT_API_KEY=your_landingai_api_key_here

# ── LangSmith ─────────────────────────────────────────────────────────────────
# Observability and evaluation for RAG
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=Agentic_RAG
